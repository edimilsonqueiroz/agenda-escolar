FLASK_ENV=development
SECRET_KEY=troque-esta-chave
# Desenvolvimento (SQLite)
DEVELOPMENT_DATABASE_URL=sqlite:///agenda_escolar.db

# Producao (PostgreSQL) - use em servidor com FLASK_ENV=production
# Exemplo local: postgresql+psycopg://postgres:postgres@localhost:5432/agenda_escolar
PRODUCTION_DATABASE_URL=
RATE_LIMIT_DEFAULT=200/day;50/hour
